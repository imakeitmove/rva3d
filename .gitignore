# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/generated/prisma

# Rights-pending work previews. Generic preview code is tracked; client data is not.
/public/_work_preview/
/src/content/work_preview.local.json
/scripts/build_work_preview_media.local.mjs
/scripts/capture_work_preview.local.mjs
/work_preview_output/

# Unlicensed local visual evaluation only. Replace with a purchased,
# web-embedding-approved font before removing this safeguard.
/public/fonts/local-evaluation/NotJustGroovy-enmp.ttf

# Candidate verification profiles and private generated media are never broadly staged.
/scripts/runtime/
/private-media/
# Prepared private Preview packages and local verification only.
/.preview-release.json
/qa-runtime/
